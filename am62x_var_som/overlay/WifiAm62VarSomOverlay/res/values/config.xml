<resources>
    <!-- brcmfmac re-initializes the BCM4339 on resume from deep sleep,
         briefly taking wlan0 down. SelfRecovery reacts to the iface-down
         by disabling Wi-Fi; let the iface-added event that follows turn
         it back on instead of leaving Wi-Fi off until the user toggles
         it manually. -->
    <bool translatable="false" name="config_wifiInterfaceAddedSelfRecoveryEnabled">true</bool>
</resources>
