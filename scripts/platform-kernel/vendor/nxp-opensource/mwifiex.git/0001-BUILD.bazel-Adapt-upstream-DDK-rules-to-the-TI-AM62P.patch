From 79227874fbdceb3104243e17493684b5a75166f5 Mon Sep 17 00:00:00 2001
From: Marius Bagassien <marius.b@variscite.com>
Date: Fri, 24 Apr 2026 16:24:32 +0200
Subject: [PATCH] BUILD.bazel: Adapt upstream DDK rules to the TI AM62P kernel

Upstream's BUILD.bazel hardcodes kernel_build, header deps and
visibility for the i.MX Android kernel workspace. Repoint them at the
TI AM62P workspace:

  kernel_build = "//:target_kernel_build"
  deps         = "//:target_kernel_headers"
  visibility   = "//private/devices/ti/am6x:__pkg__"

COPTS and sources are kept verbatim from upstream, so every bus and
chip variant stays enabled. The i.MX-only mlan-ddk / moal-ddk /
mwifiex_modules targets are dropped as exact duplicates of mlan / moal.

Signed-off-by: Marius Bagassien <marius.b@variscite.com>
---
 BUILD.bazel | 92 +++++++----------------------------------------------
 1 file changed, 12 insertions(+), 80 deletions(-)

diff --git a/BUILD.bazel b/BUILD.bazel
index 5d2a17c..9f7dc76 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -1,10 +1,9 @@
-# NOTE: THIS FILE IS EXPERIMENTAL FOR THE BAZEL MIGRATION AND NOT USED FOR
-# YOUR BUILDS CURRENTLY.
-#
-# It is not yet the source of truth for your build. If you're looking to modify
-# the build file, modify the Android.bp file instead. Do *not* modify this file
-# unless you have coordinated with the team managing the Soong to Bazel
-# migration.
+# Variscite-adapted from upstream's experimental BUILD.bazel: only the
+# kernel_build, header deps and visibility labels are repointed from the
+# i.MX Android kernel workspace to the TI AM62P one. COPTS and sources
+# are kept verbatim from upstream — all buses and chip variants stay
+# enabled. The i.MX-only mlan-ddk / moal-ddk / mwifiex_modules targets
+# are dropped as exact duplicates of mlan / moal.
 load("//build/kernel/kleaf:kernel.bzl", "ddk_module", "ddk_headers")
 
 # The various "-I" flags in the Makefiles.
@@ -86,9 +85,9 @@ ddk_module(
     ],
     hdrs = [":mwifiex_headers"],
     copts = ANDROID_MWIFIEX_COPTS,
-    kernel_build = "//kernel_imx:imx_ddk_modules",
-    deps = ["//common:all_headers_aarch64"],
-    visibility = ["//kernel_imx:__pkg__"],
+    kernel_build = "//:target_kernel_build",
+    deps = ["//:target_kernel_headers"],
+    visibility = ["//private/devices/ti/am6x:__pkg__"],
 )
 
 # Module: moal.ko
@@ -115,76 +114,9 @@ ddk_module(
     ],
     hdrs = [":mwifiex_headers"],
     deps = [":mlan",
-            "//common:all_headers_aarch64",
+            "//:target_kernel_headers",
     ], # moal.ko depends on symbols from mlan.ko
     copts = ANDROID_MWIFIEX_COPTS,
-    kernel_build = "//kernel_imx:imx_ddk_modules",
-    visibility = ["//kernel_imx:__pkg__"],
-)
-
-
-# Module: mlan.ko
-ddk_module(
-    name = "mlan-ddk",
-    out = "mlan.ko",
-    srcs = [
-        "mlan/mlan_shim.c", "mlan/mlan_init.c", "mlan/mlan_txrx.c",
-        "mlan/mlan_cmdevt.c", "mlan/mlan_misc.c", "mlan/mlan_cfp.c",
-        "mlan/mlan_module.c", "mlan/mlan_wmm.c", "mlan/mlan_11n_aggr.c",
-        "mlan/mlan_11n_rxreorder.c", "mlan/mlan_11n.c", "mlan/mlan_11ac.c",
-        "mlan/mlan_11ax.c", "mlan/mlan_11d.c", "mlan/mlan_11h.c",
-        # Conditional objects
-        "mlan/mlan_sdio.c",
-        "mlan/mlan_pcie.c",
-        "mlan/mlan_meas.c", "mlan/mlan_scan.c", "mlan/mlan_sta_ioctl.c",
-        "mlan/mlan_sta_rx.c", "mlan/mlan_sta_tx.c", "mlan/mlan_sta_event.c",
-        "mlan/mlan_sta_cmd.c", "mlan/mlan_sta_cmdresp.c", "mlan/mlan_join.c",
-        "mlan/mlan_uap_ioctl.c", "mlan/mlan_uap_cmdevent.c", "mlan/mlan_uap_txrx.c",
-    ],
-    hdrs = [":mwifiex_headers"],
-    copts = ANDROID_MWIFIEX_COPTS,
-    kernel_build = "//common:imx",
-    deps = ["//common:all_headers_aarch64"],
-    visibility = ["//common:__pkg__"],
-)
-
-# Module: moal.ko
-ddk_module(
-    name = "moal-ddk",
-    out = "moal.ko",
-    srcs = [
-        "mlinux/moal_main.c", "mlinux/moal_ioctl.c", "mlinux/moal_shim.c",
-        "mlinux/moal_eth_ioctl.c", "mlinux/moal_init.c",
-        # Conditional objects
-        "mlinux/moal_uap.c",
-        "mlinux/moal_proc.c", # Enabled by CONFIG_PROC_FS
-        "mlinux/moal_debug.c", # Enabled by CONFIG_PROC_FS
-        "mlinux/moal_sdio_mmc.c",
-        "mlinux/moal_pcie.c",
-        "mlinux/moal_cfg80211.c",
-        "mlinux/moal_cfg80211_util.c",
-        "mlinux/moal_sta_cfg80211.c",
-        "mlinux/moal_uap_cfg80211.c",
-        "mlinux/moal_priv.c",
-        "mlinux/moal_wext.c",
-        "mlinux/moal_uap_priv.c",
-        "mlinux/moal_uap_wext.c",
-    ],
-    hdrs = [":mwifiex_headers"],
-    deps = [":mlan-ddk",
-            "//common:all_headers_aarch64",
-    ], # moal.ko depends on symbols from mlan.ko
-    copts = ANDROID_MWIFIEX_COPTS,
-    kernel_build = "//common:imx",
-    visibility = ["//common:__pkg__"],
-)
-
-# Filegroup
-filegroup(
-    name = "mwifiex_modules",
-    srcs = [
-        ":mlan-ddk",
-        ":moal-ddk",
-    ],
-    visibility = ["//common:__pkg__"],
+    kernel_build = "//:target_kernel_build",
+    visibility = ["//private/devices/ti/am6x:__pkg__"],
 )
-- 
2.43.0

